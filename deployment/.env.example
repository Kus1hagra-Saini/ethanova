# ============================================================
# Ethanova Environment Configuration - EXAMPLE
# ============================================================
# Copy this file to `.env` in the same directory and adjust values.
# `.env` is gitignored and must never be committed.

# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------
POSTGRES_USER=ethanova
POSTGRES_PASSWORD=ethanova_dev_pw
POSTGRES_DB=ethanova

# ------------------------------------------------------------
# Notes
# ------------------------------------------------------------
# - These are DEVELOPMENT credentials only.
# - Production credentials must never live in .env files.
# - Real production deploys inject secrets via cloud secret managers.