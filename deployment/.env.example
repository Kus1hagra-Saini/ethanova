# ============================================================
# Ethanova Environment Configuration - EXAMPLE
# ============================================================
# Copy this file to `.env` in the same directory and adjust values.
# `.env` is gitignored and must never be committed.

# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------
POSTGRES_USER=ethanova
POSTGRES_PASSWORD=ethanova_dev_pw
POSTGRES_DB=ethanova

# ------------------------------------------------------------
# Airflow (M5)
# ------------------------------------------------------------
# Host UID owning bind-mounted files. Windows Docker Desktop / WSL2 typically
# works fine with the Airflow default of 50000. On native Linux, `id -u`.
AIRFLOW_UID=50000

# 32-byte URL-safe base64 Fernet key.
# Generate one locally (never paste real keys into this example file):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Then put the value into deployment/.env (gitignored).
AIRFLOW_FERNET_KEY=4ts8wy17gzdeM7DTup_yCYydHbmwzegAvHVknzuXLrg=

# Initial Airflow admin user created on first boot by airflow-init.
# Demo credentials only — call this out honestly during the review.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# ------------------------------------------------------------
# Notes
# ------------------------------------------------------------
# - These are DEVELOPMENT credentials only.
# - Production credentials must never live in .env files.
# - Real production deploys inject secrets via cloud secret managers.